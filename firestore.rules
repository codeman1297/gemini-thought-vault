rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Catch-all default deny: No unmapped access or global collectionGroup leakage
    match /{document=**} {
      allow read, write: if false;
    }

    // User root namespace: strictly owner-isolated
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Thread collection
      match /threads/{threadId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(threadId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120;
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);

        // Interaction subcollection
        match /interactions/{interactionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(interactionId)
            && request.resource.data.userId == userId
            && request.resource.data.userPrompt is string
            && request.resource.data.userPrompt.size() <= 10000;
          allow update: if isOwner(userId)
            && request.resource.data.userId == resource.data.userId;
          allow delete: if isOwner(userId);
        }

        // Reflection subcollection (AI Reflection Engine Insights)
        match /reflections/{reflectionId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(reflectionId)
            && request.resource.data.userId == userId
            && request.resource.data.summary is string
            && request.resource.data.summary.size() <= 1000;
          allow update: if isOwner(userId)
            && request.resource.data.userId == resource.data.userId;
          allow delete: if isOwner(userId);
        }
      }

      // Thought Evolution subcollection (Milestone 9)
      match /evolution/{docId} {
        // 'latest' document: Read-only for authenticated owner.
        // Client writes are FORBIDDEN. Only Admin SDK writes this document.
        allow read: if isOwner(userId) && docId == 'latest';
        allow write: if false;

        // 'lock' document: Completely hidden from direct browser access.
        // Managed exclusively by server-side Admin SDK transactions.
        allow read, write: if false;
      }

      // Ask My Journal Cache subcollection (Milestone 10.5)
      match /ask_cache/{cacheId} {
        // Completely hidden from direct browser access.
        // Managed exclusively by backend Admin SDK with verified identity.
        allow read, write: if false;
      }

      // Personal Journal Insights Cache subcollection (Milestone 10.6)
      match /insight_cache/{cacheId} {
        // Completely hidden from direct browser access.
        // Managed exclusively by backend Admin SDK with verified identity.
        allow read, write: if false;
      }
    }
  }
}
