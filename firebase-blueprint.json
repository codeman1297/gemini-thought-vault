{
  "entities": {
    "JournalThread": {
      "title": "JournalThread",
      "description": "A private, user-owned journal conversation thread or topic.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the journal thread"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Title or topic of the thread"
        },
        "previewSnippet": {
          "type": "string",
          "maxLength": 150,
          "description": "Opening thought snippet"
        },
        "turnCount": {
          "type": "number",
          "description": "Number of interaction turns in the thread"
        },
        "coreThemes": {
          "type": "array",
          "description": "Aggregated core reflection themes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Thread creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest interaction timestamp"
        },
        "lastInteractionId": {
          "type": "string",
          "description": "Identifier of the most recent interaction"
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "description": "Lifecycle status of the thread"
        }
      },
      "required": ["id", "userId", "title", "turnCount", "createdAt", "updatedAt", "status"]
    },
    "JournalInteraction": {
      "title": "JournalInteraction",
      "description": "A single user thought and Gemini reflection turn.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique interaction identifier or client idempotency token"
        },
        "threadId": {
          "type": "string",
          "description": "Parent thread identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "turnIndex": {
          "type": "number",
          "description": "0-based turn index in the thread"
        },
        "userPrompt": {
          "type": "string",
          "maxLength": 10000,
          "description": "Sanitized user thought"
        },
        "geminiResponse": {
          "type": "string",
          "maxLength": 15000,
          "description": "Reflective companion response generated by Gemini"
        },
        "insights": {
          "type": "object",
          "description": "Extracted themes and open reflective questions"
        },
        "modelMetadata": {
          "type": "object",
          "description": "Model used, fallback indicator, attempts, and latency"
        },
        "clientInteractionId": {
          "type": "string",
          "description": "Client idempotency key"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Interaction timestamp"
        }
      },
      "required": ["id", "threadId", "userId", "turnIndex", "userPrompt", "geminiResponse", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/threads/{threadId}": {
      "schema": "JournalThread",
      "description": "User-scoped journal threads containing topics, snippets, and summary metadata."
    },
    "/users/{userId}/threads/{threadId}/interactions/{interactionId}": {
      "schema": "JournalInteraction",
      "description": "User-scoped conversation turns preserving user thoughts, Gemini reflections, and metadata."
    }
  }
}
